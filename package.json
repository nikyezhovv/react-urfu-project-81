  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx ./src/index.ts",
    "lint": "oxlint && oxfmt --ignore-path=.oxfmtignore --check",
